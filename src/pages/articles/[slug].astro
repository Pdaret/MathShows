---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import Callout from "../../components/Callout.astro";
import { getArticles, type Article } from "../../lib/site";

export const getStaticPaths = (async () =>
  (await getArticles()).map(article => ({ params: { slug: article.id }, props: { article } }))) satisfies GetStaticPaths;

const { article } = Astro.props as { article: Article };
const { Content, headings } = await render(article);
---
<ArticleLayout article={article} headings={headings}>
  <Content components={{ Callout }} />
</ArticleLayout>
