---
import type { Article } from "../lib/site";
import { articleUrl, demoCount, faNum, faDate } from "../lib/site";
import Chips from "./Chips.astro";
import LevelBadge from "./LevelBadge.astro";
interface Props { article: Article; [attr: `data-${string}`]: string }
const { article, ...attrs } = Astro.props;
const d = article.data;
const demos = demoCount(article);
---
<li {...attrs}>
  <article class="card">
    <Chips article={article} />
    <h2><a href={articleUrl(article)}>{d.title}</a></h2>
    <p>{d.summary}</p>

    <div class="card-foot article-meta">
      <time datetime={d.date.toISOString()}>{faDate(d.date)}</time>
      <LevelBadge level={d.level} />
      <span>{faNum(d.minutes)} دقیقه</span>
      {demos > 0 && <span>{faNum(demos)} دموی تعاملی</span>}
    </div>
  </article>
</li>
