---
import "katex/dist/katex.min.css";
import "../styles/global.css";
import { SITE, url } from "../lib/site";
import ThemeToggle from "../components/ThemeToggle.astro";
import PaletteSelect from "../components/PaletteSelect.astro";

interface Props {
  title?: string;
  description?: string;
  /** Extra class on <main>. */
  mainClass?: string;
}
const { title, description = SITE.description, mainClass } = Astro.props;
const fullTitle = title ? `${title} — ${SITE.title}` : `${SITE.title} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href={url("favicon.svg")} />
  <link rel="alternate" type="application/rss+xml" title={SITE.title} href={url("rss.xml")} />
  <link rel="sitemap" href={url("sitemap-index.xml")} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content="fa_IR" />
  <meta name="theme-color" content="#fcfcfa" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#111318" media="(prefers-color-scheme: dark)" />
  <!-- Apply saved theme before first paint (no flash). -->
  <script is:inline>
    try {
      const t = localStorage.getItem("theme");
      if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      const hue = localStorage.getItem("random-hue");
      if (hue !== null && /^\d{1,3}$/.test(hue) && Number(hue) < 360) {
        document.documentElement.style.setProperty("--random-hue", hue);
        if (localStorage.getItem("palette") === "random") document.documentElement.dataset.palette = "random";
      }
      const p = localStorage.getItem("palette");
      if (["paper", "red", "amber", "slate", "crimson", "wine"].includes(p)) document.documentElement.dataset.palette = p;
    } catch {}
  </script>
</head>
<body>
  <a class="skip-link" href="#main">پرش به محتوا</a>
  <header class="site-header">
    <div class="container">
      <a class="brand" href={url()}>{SITE.title}</a>
      <nav class="site-nav" aria-label="اصلی">
        <a href={url()} aria-current={path === url() ? "page" : undefined}>مقاله‌ها</a>
        <a href={url("explore/")} aria-current={path.startsWith(url("explore/")) ? "page" : undefined}>کاوش</a>
        <a href={url("tags/")} aria-current={path.startsWith(url("tags/")) ? "page" : undefined}>برچسب‌ها</a>
      </nav>
      <details class="appearance">
        <summary aria-label="تنظیمات ظاهر" title="تنظیمات ظاهر">
          <svg class="appearance-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="8" /><path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor" stroke="none" /></svg>
          <span class="appearance-label">ظاهر</span>
        </summary>
        <div class="appearance-panel">
          <PaletteSelect />
          <div class="appearance-mode"><span>روشن / تیره</span><ThemeToggle /></div>
          <a href={url("rss.xml")} class="feed-link">دریافت نوشته‌ها با RSS</a>
        </div>
      </details>
    </div>
  </header>
  <main id="main" class={mainClass}>
    <slot />
  </main>
  <footer class="site-footer">
    <div class="container">
      <span>{SITE.title} — {SITE.tagline}</span>
      <a href="https://github.com/Pdaret/MathShows">GitHub</a>
    </div>
  </footer>
</body>
</html>
