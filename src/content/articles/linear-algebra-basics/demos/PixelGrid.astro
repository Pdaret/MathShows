---
// Fig 6: 12x12 grayscale image with pixel values. Pure SVG, rendered at build time (no JS).
const n = 12, s = 34;
const cells = Array.from({ length: n * n }, (_, k) => {
  const x = k % n, y = Math.floor(k / n);
  const v = Math.round(Math.max(0, Math.min(255, 255 - Math.hypot(x - 5.5, y - 5.5) * 40)));
  return { x, y, v };
});
---
<svg viewBox={`0 0 ${n * s} ${n * s}`} width={n * s} role="img" aria-label="تصویر ۱۲×۱۲ با مقدار روشنایی هر پیکسل">
  {cells.map(({ x, y, v }) => (
    <g>
      <rect x={x * s} y={y * s} width={s} height={s} fill={`rgb(${v},${v},${v})`} />
      <text x={x * s + s / 2} y={y * s + s / 2 + 4} text-anchor="middle" font-size="11" class="math" style={`fill:${v > 128 ? "#000" : "#fff"}`}>{v}</text>
    </g>
  ))}
</svg>
